# Project vars — the Sanity CLI fills these in during `sanity init --template`.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=

# Required for `sanity app deploy`
# SANITY_STUDIO_ORGANIZATION_ID=

# Production Studio URL for dashboard "Open in Studio" links
# Optional if SANITY_STUDIO_HOSTNAME is set (defaults to https://<hostname>.sanity.studio)
# SANITY_STUDIO_URL=

# Hosted Studio slug for `sanity deploy --url` (no https://)
# Production: mise-kitchen-os-tm
# Development: mise-kitchen-os-tm-dev
# SANITY_STUDIO_HOSTNAME=
# SANITY_STUDIO_APP_ID=  # optional; set per hostname after first deploy

# Presentation tool — iframe preview of the Astro app
# Where Presentation loads the Astro app. Leave unset: `sanity dev` uses
# http://localhost:4321 and `sanity deploy` uses the dev worker
# (https://mise-web-dev.shehjkhan.workers.dev). Setting it here also applies to
# deploys, so never set it to localhost.
# SANITY_STUDIO_PREVIEW_URL=
